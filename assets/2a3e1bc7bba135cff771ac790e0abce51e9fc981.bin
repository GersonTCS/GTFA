{"stateRefs":{"comp-mndjec0i":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-mndjec0s":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-mndjec0l":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}}},"structure":{"components":{"comp-mndjec0i":{"componentType":"WRichText","pageId":"unqza"},"comp-mndjec0s":{"componentType":"WRichText","pageId":"unqza"},"pageBackground_unqza":{"componentType":"PageBackground","pageId":"masterPage"},"unqza":{"components":["Containerunqza"],"componentType":"Page","uiType":"TransparentPageSkin","pageId":"unqza"},"comp-mndjec0l":{"components":["comp-mndjec0i","comp-mndjec0s"],"componentType":"ClassicSection","pageId":"unqza"},"Containerunqza":{"components":["comp-mndjec0l"],"componentType":"Group","pageId":"unqza"}},"features":["accessibilityBrowserZoom","animationsWixCodeSdk","animations","authenticationWixCodeSdk","captcha","clickHandlerRegistrar","components","consentPolicy","domSelectors","environmentService","fedopsWixCodeSdk","imagePlaceholder","landingPage","locationWixCodeSdk","motion","mpaNavigation","navigationManager","navigation","ooiTpaSharedConfig","pageAnchors","pageTransitions","platformPubsub","protectedPages","renderer","reporter","scrollRestoration","scrollToAnchor","seoWixCodeSdk","seo","siteMembersWixCodeSdk","siteMembers","siteWixCodeSdk","ssrCache","tpaCommons","windowScroll","windowWixCodeSdk","wixEmbedsApi","componentsLoader","platform"],"siteFeaturesConfigs":null},"props":{"render":{"compProps":{"comp-mndjec0i":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"text-align:center; font-size:30px;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Privacy Policy</span></span></span></h1>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mndjec0s":{"html":"<h3 class=\"font_3 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.5em;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">We collect only what we need, we don&#39;t sell your information, and we treat your data the way we treat your home, with care and respect. The full details are below.</span></span></span></h3>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">​</span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"font-size:20px; line-height:1.5em;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Who We Are</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Georgetown Family Assistants (&quot;GFA,&quot; &quot;we,&quot; &quot;us,&quot; or &quot;our&quot;) is a locally owned and operated personal assistant service based in Georgetown, Texas. We provide in-home and errand-based services for families and seniors in the Georgetown area.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">If you have any questions about this policy, you can reach us at:</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Phone number: <span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a class=\"wixui-rich-text__text\">+1 737-245-6932</a></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"></span>Email address: <span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"mailto:infogtfa@email.com\" target=\"_self\" class=\"wixui-rich-text__text\">infogtfa@email.com</a></span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">What Information We Collect</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We collect information in two ways &mdash; directly from you, and automatically when you use our website.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Information you give us directly:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Your name</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Phone number and email address</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Home address or service location</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Information about who the services are for (yourself or a family member)</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Service preferences, scheduling requests, and any special instructions you provide</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Payment information (processed securely through our payment provider &mdash; we do not store your card details)</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Any other information you choose to share through our contact or booking forms</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Information collected automatically: When you visit our website, we may automatically collect basic technical information including:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Your IP address</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Browser type and device information</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Pages visited and time spent on the site</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Referring website or search term that brought you here</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">This information is collected through standard website analytics tools (such as Google Analytics or Wix Analytics) and helps us understand how visitors use our site so we can improve it.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">How We Use Your Information</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We use the information we collect to:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Respond to your inquiries and booking requests</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Schedule and coordinate your service visits</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Communicate with you about your appointments, updates, or changes</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Process payments securely</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Improve our website and services</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Comply with legal obligations</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We do not use your information for automated decision-making or profiling.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">How We Share Your Information</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We do not sell, rent, or trade your personal information. Full stop.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We may share limited information with trusted third parties only when necessary to operate our business, including:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Payment processors &mdash; to securely handle billing and transactions</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Scheduling or operations software &mdash; to manage appointments and communications</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Website platform providers &mdash; our site is hosted on Wix, which has its own privacy practices you can review at wix.com/about/privacy</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Legal authorities &mdash; if required by law, court order, or to protect the safety of our clients, staff, or the public</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Any third party we work with is required to handle your information responsibly and only for the purposes we specify.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Cookies and Tracking</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Our website uses cookies (small text files stored on your device) to help the site function properly and to understand how it&#39;s being used.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Types of cookies we use:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Essential cookies &mdash; required for the site to work (e.g., form functionality, navigation)</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Analytics cookies &mdash; help us understand visitor behavior so we can improve the site (e.g., Google Analytics)</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Marketing cookies &mdash; may be set by third-party tools if we run advertising campaigns (e.g., Facebook Pixel)</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">You can control cookies through your browser settings. Note that disabling certain cookies may affect how the site functions.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">If you are visiting from the European Union or California, additional rights may apply. See Sections 8 and 9 below.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">How We Protect Your Information</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We take reasonable technical and organizational precautions to protect your personal information from unauthorized access, loss, or misuse. These include:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Secure HTTPS encryption on our website</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Limited internal access to client information</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Trusted, reputable third-party platforms for payments and communications</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">No method of transmission over the internet is 100% secure. While we do everything we reasonably can to protect your data, we cannot guarantee absolute security.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">How Long We Keep Your Information</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We retain your information only as long as necessary to provide our services and fulfill the purposes described in this policy &mdash; or as required by law.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">If you&#39;d like us to delete your information, see Section 10 on how to contact us.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">California Residents (Your Rights Under CCPA)</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">If you are a California resident, you have the right to:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Know what personal information we collect about you and how it is used</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Request deletion of your personal information</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Opt out of the sale of your personal information (we do not sell data)</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Not be discriminated against for exercising these rights</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">To make a request, contact us using the information in Section 10. We will respond within 45 days.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">European Users (Your Rights Under GDPR)</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">If you are located in the European Economic Area, you have the right to:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Access the personal data we hold about you</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Request correction of inaccurate data</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Request deletion of your data</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Object to or restrict how we process your data</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Request a copy of your data in a portable format</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">To exercise any of these rights, contact us using the information in Section 10.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Our lawful basis for processing your information is legitimate interest (operating and improving our services) and, where applicable, your consent or the performance of a contract.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Your Choices and How to Contact Us</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">You can contact us at any time to:</span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-family:alfabet,sans-serif; font-weight:normal; font-size:16px;\">\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Ask what information we have about you</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Request corrections or updates</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Request that we delete your information</span></span></p>\n</li>\n<li style=\"line-height:1.5em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Opt out of marketing communications</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Georgetown Family Assistants Georgetown, TX [PROOF NEEDED: Phone number] [PROOF NEEDED: Email address]</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">To unsubscribe from emails, use the unsubscribe link in any message we send or email us directly and we&#39;ll remove you promptly.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Children&#39;s Privacy</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Our services and website are not directed at children under the age of 13. We do not knowingly collect personal information from children. If you believe a child has submitted information to us, please contact us and we will delete it.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Third-Party Links</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Our website may contain links to third-party websites (such as payment platforms or social media). We are not responsible for the privacy practices of those sites. We encourage you to read their privacy policies before submitting any personal information.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Changes to This Policy</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We may update this Privacy Policy from time to time. When we do, we&#39;ll update the &quot;Last Updated&quot; date at the top of this page. If changes are significant, we&#39;ll make reasonable efforts to notify you &mdash; by email or by a notice on our website.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Continued use of our website or services after any changes means you accept the updated policy.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<h4 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:20px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Questions?</span></span></span></h4>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">If anything in this policy is unclear or you have a concern about how we handle your information, please reach out. We&#39;re a small local business and we take this seriously.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Georgetown Family Assistants Georgetown, TX </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Phone number: +1 737-245-6932</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\">Email address: <span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"mailto:infogtfa@email.com\" target=\"_self\" class=\"wixui-rich-text__text\">infogtfa@email.com</a></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"pageBackground_unqza":{"fillLayers":{"containerId":"pageBackground_unqza","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"isMediaPositionOverride":false,"mediaHeightOverrideType":""},"unqza":{"className":"theme-vars"},"comp-mndjec0l":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-mndjec0l","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"anchorUrlFragment":"english-privacy-policy-2","dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"Containerunqza":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]}}}},"__componentsConfig__":{"tpa":{}},"accessibilityBrowserZoom":{"isBuilder":false,"isStudio":false},"animations":{"repeaterTemplateToParentMap":{},"isPreview":false},"components":{"componentsUnderFoldMap":{}},"domSelectors":{"allComponentIds":["comp-mndjec0i","comp-mndjec0s","pageBackground_unqza","unqza","comp-mndjec0l","Containerunqza"]},"imagePlaceholder":{"staticMediaUrl":"https://static.wixstatic.com/media","isSEOBot":false,"userDomainMediaBaseUrl":"","userDomainMediaPrefixes":[]},"landingPage":{"isLandingPage":false},"motion":{"animationDataByCompId":{},"scrubAnimationBreakpoints":[],"repeaterTemplateToParentMap":{},"isResponsive":false},"pageAnchors":{"anchors":[{"dataId":"anchors-lvz0et6p8","compId":"comp-mndjec0l","name":"English - Privac