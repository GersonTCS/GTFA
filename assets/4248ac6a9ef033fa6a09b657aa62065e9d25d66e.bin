Page"},"c04es":{"components":["Containerc04es"],"componentType":"Page","uiType":"TransparentPageSkin","pageId":"c04es"},"comp-mnol0wka":{"components":["comp-mnol0wkb2","comp-mnol0wkc1","comp-mpckdwyp"],"componentType":"ClassicSection","pageId":"c04es"},"comp-mnol0wkg5":{"components":["comp-mnol0wkh8","comp-mnol0wki5","comp-mnol0wkk5","comp-mpckme57","comp-mpckm1sj"],"componentType":"ClassicSection","pageId":"c04es"},"comp-mnol0wl0":{"components":["comp-mnol0wl1","comp-mnol0wl22","comp-mpckp1cn","comp-mnoojbzc","comp-mnol0wl6","comp-mnoonm33","comp-mnoonm37"],"componentType":"ClassicSection","pageId":"c04es"},"comp-mnooo94s":{"components":["comp-mnooo9508","comp-mnooo94z6","comp-mq98ju9t","comp-mnooo9523","comp-mnooo9532"],"componentType":"ClassicSection","pageId":"c04es"},"Containerc04es":{"components":["comp-mnol0wka","comp-mnol0wkg5","comp-mnol0wl0","comp-mnooo94s"],"componentType":"Group","pageId":"c04es"}},"features":["accessibilityBrowserZoom","animationsWixCodeSdk","animations","authenticationWixCodeSdk","captcha","clickHandlerRegistrar","components","consentPolicy","domSelectors","environmentService","fedopsWixCodeSdk","imagePlaceholder","imageZoom","landingPage","locationWixCodeSdk","motion","mpaNavigation","navigationManager","navigation","ooiTpaSharedConfig","pageAnchors","platformPubsub","protectedPages","renderer","reporter","scrollRestoration","scrollToAnchor","seoWixCodeSdk","seo","siteMembersWixCodeSdk","siteMembers","siteWixCodeSdk","ssrCache","tpaCommons","windowScroll","windowWixCodeSdk","wixEmbedsApi","componentsLoader","platform"],"siteFeaturesConfigs":null},"props":{"render":{"compProps":{"comp-mnol0wkb2":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:30px; line-height:1.1em; text-align:center;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\">Built by a local family, for local families.</span></span></span></span></h1>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnol0wkc1":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.8em; text-align:center;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We&#39;re not a staffing agency. </span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mpckdwyp":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em; text-align:center;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">We&#39;re neighbors </span>who got tired of wishing someone would just help.</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnol0wkh8":{"html":"<h2 class=\"font_0 wixui-rich-text__text\" style=\"font-size:28px;\"><span style=\"font-size:28px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Our Story</span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnol0wki5":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">For a long time, we were just managing. Dylan was working 48-hour shifts at the Fire Department. Erin was running her own business, seeing clients as a dietitian, and doing the mental math that comes with raising two kids. The house was always behind. Groceries, errands, the pile of things that kept getting pushed to next week.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">We finally just hired someone to help, but we needed someone that didn&#39;t just watch the kids or clean the house. We needed someone to handle our to-do list and take off the mental load.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">It was one of the best decisions we ever made. We got our time and peace if mind back.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">We couldn&#39;t stop thinking about how many families in Georgetown needed exactly that and had no good way to find it. So we built it.​</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnol0wkk5":{"uri":"575d44_51ab873d64ff46458141d807b4ab6eb1~mv2.jpeg","alt":"SimplyBreezyPhotography030525 (89).JPEG","width":2400,"height":3600,"name":"SimplyBreezyPhotography030525 (89).JPEG","containerId":"comp-mnol0wkk5","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"hasAnimation":false,"crop":{"x":377,"y":612,"width":1628,"height":1873,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/575d44_51ab873d64ff46458141d807b4ab6eb1~mv2.jpeg/v1/crop/x_377,y_612,w_1628,h_1873/fill/w_198,h_228,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/SimplyBreezyPhotography030525%20(89)_JPEG.jpeg","srcset":"https://static.wixstatic.com/media/575d44_51ab873d64ff46458141d807b4ab6eb1~mv2.jpeg/v1/crop/x_377,y_612,w_1628,h_1873/fill/w_198,h_228,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/SimplyBreezyPhotography030525%20(89)_JPEG.jpeg 1x, https://static.wixstatic.com/media/575d44_51ab873d64ff46458141d807b4ab6eb1~mv2.jpeg/v1/crop/x_377,y_612,w_1628,h_1873/fill/w_396,h_456,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/SimplyBreezyPhotography030525%20(89)_JPEG.jpeg 2x","css":{"container":{"position":"relative"},"img":{"width":198,"height":228,"objectFit":"cover"}}},"containerWidth":198,"containerHeight":228,"isInFirstFold":false,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-mnol0wkk5","mainPageId":"syg00","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-mpckme57":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:22px;\"><span style=\"font-size:22px;\" class=\"wixui-rich-text__text\">​<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Why We&#39;re Different</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mpckm1sj":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">We vet every assistant in person, run background checks, and only put people in homes we&#39;d be comfortable putting in our own.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:14px;\"><span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">We also built this specifically for types of families - seniors who want to stay in their homes and keep their independence, and busy families who just need reliable help.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnol0wl1":{"html":"<h2 class=\"font_0 wixui-rich-text__text\" style=\"font-size:24px; text-align:center;\"><span style=\"font-size:24px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Meet the Team</span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnol0wl22":{},"comp-mpckp1cn":{"uri":"575d44_caa7b86ca3f8483caac2d1d292ce7e79~mv2.jpg","width":2336,"height":3500,"title":"about us1.jpg","containerId":"comp-mpckp1cn","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"hasAnimation":false,"crop":{"x":392,"y":878,"width":1620,"height":1476,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/575d44_caa7b86ca3f8483caac2d1d292ce7e79~mv2.jpg/v1/crop/x_392,y_878,w_1620,h_1476/fill/w_260,h_237,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/575d44_caa7b86ca3f8483caac2d1d292ce7e79~mv2.jpg","srcset":"https://static.wixstatic.com/media/575d44_caa7b86ca3f8483caac2d1d292ce7e79~mv2.jpg/v1/crop/x_392,y_878,w_1620,h_1476/fill/w_260,h_237,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/575d44_caa7b86ca3f8483caac2d1d292ce7e79~mv2.jpg 1x, https://static.wixstatic.com/media/575d44_caa7b86ca3f8483caac2d1d292ce7e79~mv2.jpg/v1/crop/x_392,y_878,w_1620,h_1476/fill/w_520,h_474,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/575d44_caa7b86ca3f8483caac2d1d292ce7e79~mv2.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":260,"height":237,"objectFit":"cover"}}},"containerWidth":260,"containerHeight":237,"isInFirstFold":false,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-mpckp1cn","mainPageId":"syg00","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-mnoojbzc":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:22px; line-height:1.4em;\"><span style=\"font-size:22px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Dylan Kenny</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.4em; font-size:13px;\">Lieutenant / Paramedic + Co-Founder</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnol0wl6":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:13px;\">Dylan has been in the fire and EMS world for over 15 years. He knows what it means to show up for people on their worst days, and he brings that same reliability to everything we do here. He&#39;s the face you&#39;ll see in the community, the one who takes the calls, and the reason clients feel like they&#39;re in good hands from the first conversation.</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnoonm33":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:22px; line-height:1.4em;\"><span style=\"font-size:22px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Erin Kenny</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.4em; font-size:13px;\">Registered Dietitian, Business Owner + Co-Founder</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnoonm37":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:13px;\">Erin is a registered dietitian and runs her own practice alongside GTFA. She&#39;s also a mom of two, which means she&#39;s lived the exact chaos this business was built to solve. She manages the day-to-day operations, client relationships, and makes sure the experience on your end actually feels like it was thought through, because it was.</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnooo9508":{},"comp-mnooo94z6":{"html":"<h2 class=\"font_0 wixui-rich-text__text\" style=\"font-size:24px; text-align:center;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-size:24px;\" class=\"wixui-rich-text__text\">Send us a message before you decide anything.</span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mq98ju9t":{"type":"button","metaData":{"schemaVersion":"1.0","sig"