\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span class=\"color_43 wixui-rich-text__text\"><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://live.vcita.com/site/ezsiba8uoukoyulv/activity/dashboard\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\">Sign in</a></span></span></span> to your portal to book a visit, update your details, or manage your schedule.</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mpcihqjp":{"html":"<h2 class=\"font_0 wixui-rich-text__text\" style=\"font-size:40px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">We are your village.</span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mpcihqk0":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.6em;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Georgetown Family Assistants was started by a local firefighter and his working wife - because we lived it ourselves.</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mpcihqk1":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:16px;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Between shifts, work, kids, and everything else on the list, we kept wishing someone could just handle the stuff that piles up. Groceries. Errands. Getting the house in order. We didn&#39;t need a housekeeper or a full-time helper. We just needed a hand.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:16px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.6em;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">So we built what we couldn&#39;t find.</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:16px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.6em; font-size:16px;\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\">Every assistant we send is vetted, background-checked, and trained to show up and get things done.</span> </span>We treat every home like our own, because this started in ours.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mpcihqk2":{"type":"button","metaData":{"schemaVersion":"1.0","sig":"m5s-292"},"id":"propItem-mpcihqk51","isMaxContent":false,"isWrapText":false,"link":{"href":"https://www.georgetownfamilyassistants.com/about","target":"_self","type":"PageLink","id":"dataItem-mpcly2oq"},"svgString":"<svg data-bbox=\"13.05 2.55 33.878 54.8\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 60\">\n    <g>\n        <path d=\"M46.5 28.9L20.6 3c-.6-.6-1.6-.6-2.2 0l-4.8 4.8c-.6.6-.6 1.6 0 2.2l19.8 20-19.9 19.9c-.6.6-.6 1.6 0 2.2l4.8 4.8c.6.6 1.6.6 2.2 0l21-21 4.8-4.8c.8-.6.8-1.6.2-2.2z\"/>\n    </g>\n</svg>\n","animationDuration":0.2,"svgAnimatedString":"","label":"Read Our Story","a11y":{},"isQaMode":false,"fullNameCompType":"wixui.StylableButton","language":"en","mainPageId":"syg00","compId":"comp-mpcihqk2","trackClicksAnalytics":false,"stylableButtonClassName":"style-mq9g66rb__root","isUdpExperimentOn":true,"svgAnimatedIcon":null},"comp-mpcihqkf":{"uri":"575d44_62b1a257ea984d4cbc58be06a65b332b~mv2.jpg","alt":"family photo1.jpg","width":2400,"height":3600,"name":"family photo1.jpg","containerId":"comp-mpcihqkf","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"hasAnimation":false,"crop":{"x":420,"y":700,"width":1425,"height":1836,"svgId":"909695c1e003409ba70b5561666c7c4d.svg"},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/575d44_62b1a257ea984d4cbc58be06a65b332b~mv2.jpg/v1/crop/x_420,y_700,w_1425,h_1836/fill/w_434,h_559,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/family%20photo1.jpg","srcset":"https://static.wixstatic.com/media/575d44_62b1a257ea984d4cbc58be06a65b332b~mv2.jpg/v1/crop/x_420,y_700,w_1425,h_1836/fill/w_434,h_559,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/family%20photo1.jpg 1x, https://static.wixstatic.com/media/575d44_62b1a257ea984d4cbc58be06a65b332b~mv2.jpg/v1/crop/x_420,y_700,w_1425,h_1836/fill/w_868,h_1118,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/family%20photo1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":434,"height":559,"objectFit":"cover"}}},"containerWidth":434,"containerHeight":559,"isInFirstFold":true,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-mpcihqkf","mainPageId":"syg00","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-mnlsrhib":{"html":"<h2 class=\"font_0 wixui-rich-text__text\" style=\"font-size:40px; text-align:center;\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:alfabet,sans-serif;\" class=\"wixui-rich-text__text\">Help for every phase of life.</span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnlsrhic":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.6em; text-align:center;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Whether you&#39;re raising a family or living independently, we show up, handle the list, and give you your time back.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mnlsrhic5":{"uri":"575d44_d0e9019770df4f0885e7e5b222a4fabe~mv2.jpg","alt":"Home-Welcome-1.jpg","width":1536,"height":2048,"name":"Home-Welcome-1.jpg","containerId":"comp-mnlsrhic5","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"hasAnimation":false,"crop":{"x":0,"y":256,"width":1536,"height":1536,"svgId":"cf545b123b6e4523b228d62bfa0dea9b.svg"},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/575d44_d0e9019770df4f0885e7e5b222a4fabe~mv2.jpg/v1/crop/x_0,y_256,w_1536,h_1536/fill/w_196,h_196,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Home-Welcome-1.jpg","srcset":"https://static.wixstatic.com/media/575d44_d0e9019770df4f0885e7e5b222a4fabe~mv2.jpg/v1/crop/x_0,y_256,w_1536,h_1536/fill/w_196,h_196,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Home-Welcome-1.jpg 1x, https://static.wixstatic.com/media/575d44_d0e9019770df4f0885e7e5b222a4fabe~mv2.jpg/v1/crop/x_0,y_256,w_1536,h_1536/fill/w_392,h_392,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Home-Welcome-1.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":196,"height":196,"objectFit":"cover"}}},"containerWidth":196,"containerHeight":196,"isInFirstFold":false,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.compon