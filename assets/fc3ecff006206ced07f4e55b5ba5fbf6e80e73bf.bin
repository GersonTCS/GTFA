{"questionEntries":[{"id":"c7165c31-3024-45bc-affa-15aec03e32ed","revision":"2","createdDate":"2026-04-07T10:24:58.130Z","updatedDate":"2026-04-07T10:25:16.401Z","question":"What exactly happens during a 4-hour visit?","draftjs":"{\"blocks\":[{\"key\":\"default_p_1\",\"type\":\"unstyled\",\"text\":\"Your assistant shows up, works through whatever's on your list, and sends you a photo update when they're done. That's it. You tell us what you need most (groceries, a clean house, errands, meal prep) and we handle it. No micromanaging required.\",\"depth\":1,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{\"dynamicStyles\":{\"padding-top\":\"2px\",\"padding-bottom\":\"3px\",\"line-height\":\"1.5\"}}}],\"entityMap\":{},\"documentStyle\":{},\"VERSION\":\"10.164.4\",\"ID\":\"0b3de183-0d86-4ee4-97ff-8f813d2756b8\"}","labels":[],"sortOrder":1.0,"status":"VISIBLE","categoryId":"cb9890d6-29b5-425f-8ae7-ab14dad3790e","slug":"what-exactly-happens"}],"pagingMetadata":{"count":1,"cursors":{"next":"617f64247080da8a55a82f798e2ee16763cb9cc8.EgIqABoWCglzb3J0T3JkZXIaCREAAAAAAADwPyIkYzcxNjVjMzEtMzAyNC00NWJjLWFmZmEtMTVhZWMwM2UzMmVkOgIIAQ"},"hasNext":true}}